# Consumed by docker compose (build args + runtime env).
ROS_DISTRO=foxy
WS_DIR=/home/dogux/ros2_foxy_ws

# Match the host user so files in the mounted workspace stay yours.
USERNAME=dogux
UID=1000
GID=1000

# Host GIDs for GPU device access (video / render).
VIDEO_GID=44
RENDER_GID=992

# ROS 2 DDS discovery. Same domain = same "network" of nodes (0-101).
ROS_DOMAIN_ID=0
# 1 restricts all traffic to this machine.
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Set to 1 if rviz2/gazebo crash or render black on the Intel iGPU.
LIBGL_ALWAYS_SOFTWARE=0
